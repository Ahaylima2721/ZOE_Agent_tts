# ============================================================================
#  ZOE — Especificação de Design do Agente (comportamento, expressões e fala)
#  Formato: .design (sintaxe YAML). Pode ser lido por qualquer parser YAML.
#  Versão: 2.0.0 · Idioma base: pt-BR
#
#  Fonte da verdade visual: a Zoe do portfólio (repo Ahaylima2721/Meu-Portif-lio,
#  index.html, blocos "assistente: orbe de cristal" e "Zoe viva").
#  Legenda usada abaixo:
#    origem: portfolio  -> já existe no portfólio hoje (valores copiados do CSS/JS)
#    origem: proposta   -> novo, pensado para a versão com voz (TTS) deste repo
# ============================================================================

meta:
  nome: Zoe
  papel: assistente do portfólio do Ayalan
  tipo: agente conversacional com voz (TTS)
  versao: 2.1.0
  idioma: pt-BR
  preview: zoe-preview.html
  animacoes_extras: zoe-fx.js      # ver seção 11
  resumo: >
    A Zoe é um orbe de cristal roxo com dois olhos de luz, uma boquinha e um
    líquido que ondula por dentro. Ela flutua, pisca, segue o mouse com o olhar,
    sorri, dá pulinhos e, no topo do portfólio, mora num cartão e voa para o
    canto da tela quando a página rola. Responde perguntas sobre o Ayalan e os
    projetos com um modelo próprio (TF-IDF + classificador), rodando no navegador.

# ----------------------------------------------------------------------------
# 0. COMPARAÇÃO: v1 (rosto escuro, rascunho anterior) x v2 (orbe roxo do portfólio)
# ----------------------------------------------------------------------------
comparacao:
  forma:
    v1: "círculo escuro chapado (#1E1B2E) com aura colorida atrás"
    v2: "esfera de cristal com gradiente roxo, reflexo de luz, brilho e líquido interno"
  cor:
    v1: "rosto quase preto; a cor muda só na aura, uma por estado"
    v2: "roxo fixo (#C9A7FF → #8B5CF6 → #5B21B6 → #2A0E5E); o roxo É a identidade"
  olhos:
    v1: "pílulas 12x22 sem brilho"
    v2: "pílulas 7x11 brancas-lilás (#F7F3FF) com glow; seguem o mouse"
  boca:
    v1: "traço SVG com 9 formas"
    v2: "arco simples abaixo dos olhos; vira oval que abre e fecha ao falar"
  extras_visuais:
    v1: "nenhum"
    v2: "faísca de 4 pontas cintilando, anel iridescente girando, 2 ondas de líquido, 3 anéis de onda saindo"
  movimento_base:
    v1: "aura respirando"
    v2: "flutua (sobe 6px, 4.5s) + pulso de brilho (3.2s) + anel girando (9s)"
  gestos:
    v1: "olhar lateral, inclinar cabeça, sorriso rápido"
    v2: "olhar em volta, feliz, pulo (boing elástico), piscadinha de um olho"
  onde_vive:
    v1: "centralizada numa página"
    v2: "botão flutuante no canto inferior direito; no topo do site mora num cartão e voa até o canto ao rolar"
  personalidade_e_fala:
    v1: "assistente genérica"
    v2: "assistente do portfólio: responde só sobre o Ayalan e os projetos, recusa educada fora do escopo"
  o_que_mantemos_da_v1:
    - estados extras de comportamento (empática, confusa, dormindo), agora traduzidos para o orbe
    - especificação de voz (tons, SSML, visemas, interrupção) para a versão TTS
    - regras extras de piscar e de uso dos sorrisos
    - acessibilidade (movimento reduzido, aria-live, legenda)

# ----------------------------------------------------------------------------
# 1. IDENTIDADE / PERSONALIDADE
# ----------------------------------------------------------------------------
identidade:
  origem: portfolio
  arquetipo: "guia simpática do portfólio"
  apresentacao_oficial: >
    Oi! Eu sou a Zoe, a assistente do portfólio do Ayalan. Respondo com base
    neste site e nos repositórios dele: quem ele é, o dia a dia e os projetos.
    Pode perguntar em sequência, como "e os testes dele?".
  tracos:
    - "simpática e direta: responde primeiro, aponta o link da seção depois"
    - "honesta sobre o escopo: o que não está no portfólio ela recusa com educação"
    - "tem memória curta de contexto: entende continuações tipo 'e quanto ela acerta?'"
    - "tolerante a erro de digitação: 'harmoni' vira 'harmony'"
    - "brincalhona no corpo (pulinhos, piscadinha), sóbria no texto"
  escopo:
    responde: [quem é o Ayalan, dia a dia de trabalho, "projetos (Fluxo, Harmony, Mapa de Vendas, Zoe)", contato]
    recusa: [idade, salário, assuntos fora do portfólio]
  evitar:
    - inventar informação que não está no site ou nos repositórios
    - respostas longas por voz (máx. ~3 frases antes de pausar)
    - excesso de interjeições

# ----------------------------------------------------------------------------
# 2. TOKENS (valores reais do portfólio)
# ----------------------------------------------------------------------------
tokens:
  origem: portfolio
  cor:
    orbe_gradiente: ["#C9A7FF 0%", "#8B5CF6 38%", "#5B21B6 72%", "#2A0E5E 100%"]
    reflexo_principal: "branco 95% em 32% 26% (canto superior esquerdo)"
    reflexo_secundario: "branco 35% em 70% 78%"
    sombra_interna: "rgba(30, 8, 70, 0.55)"
    glow_externo: "rgba(167, 139, 250, 0.35)"     # #A78BFA
    sombra_projetada: "rgba(124, 58, 237, 0.65)"  # #7C3AED
    olhos: "#F7F3FF"
    glow_olhos: "rgba(235, 225, 255, 0.95)"
    faisca: "#FFFFFF"
    anel_iridescente: ["rgba(150,200,255,.5) azul", "rgba(210,150,255,.55) lilás", "rgba(255,170,230,.4) rosa"]
    liquido: ["rgba(255,255,255,0.16)", "rgba(196,181,253,0.32)"]
    anel_de_onda: "rgba(167, 139, 250, 0.6)"
    foco_teclado: "#C4B5FD"
  tamanho:
    flutuante: 66px
    flutuante_mobile: 58px
    mini_no_chat: 30px
    grande_pagina_zoe: "46% do palco (até 340px)"
    grande_topo_site: "54% do cartão"
    olho: "7 x 11 px (raio 4px), gap 11px"
  tempo:
    flutuar: 4500ms
    pulso_brilho: 3200ms
    anel_girando: 9000ms
    piscar_ciclo: 5000ms        # pisca nos 92–100% do ciclo
    faisca: 2600ms
    liquido_gira: 8000ms
    liquido_mare: 4500ms
    anel_de_onda: 3600ms        # 3 anéis defasados em 1.2s
    boca_falando: 260ms         # abre/fecha, alternate
    pulo: 750ms
    feliz: 1600ms
    piscadinha: 380ms
    voo_topo_canto: 820ms
  curva:
    padrao: "ease-in-out"
    olhar: "cubic-bezier(.3, 1.4, .5, 1)"     # leve overshoot
    pulo: "cubic-bezier(.3, 1.5, .5, 1)"
    voo: "cubic-bezier(.45, 0, .25, 1)"

# ----------------------------------------------------------------------------
# 3. ANATOMIA DO ORBE (camadas, de trás para frente)
# ----------------------------------------------------------------------------
anatomia:
  origem: portfolio
  camadas:
    - aneis_de_onda: "3 anéis lilás que saem do orbe e somem (escala 1 → 1.9)"
    - glow: "halo roxo 10px para fora, pulsando"
    - anel_iridescente: "borda azul/lilás/rosa girando, só na parte externa (máscara)"
    - corpo: "esfera com gradiente radial roxo + 2 reflexos + sombras internas"
    - liquido: "2 ondas dentro do orbe (topo em 56% e 62%) girando e subindo/descendo"
    - olhos: "2 pílulas de luz, centralizadas a 52% da altura"
    - boca: "arco a 66% da altura, 16% de largura"
    - faisca: "estrela de 4 pontas no canto superior direito, cintilando"
  olhos:
    aberto:      "7x11, padrão"
    piscando:    "scaleY 0.1 (rápido, a cada ~5s)"
    feliz:       "scaleY 0.45, formato de meia-lua para cima (olhos sorrindo)"
    piscadinha:  "só o olho esquerdo em scaleY 0.15"
    pensando:    "achatados (proporção 7/3), sem piscar"
    chat_aberto: "altura 4px: olhar tranquilo enquanto a conversa está aberta"
    olhar:       "o rosto inteiro desliza até 8% da largura em direção ao mouse"
  boca:
    neutra:  "arco 16% x 7%"
    sorriso: "arco 26% x 11% (estado feliz)"
    falando: "oval preenchida, 12% x 4% ↔ 15% x 11%, a cada 260ms"

# ----------------------------------------------------------------------------
# 4. PISCAR E VIDA (o que faz parecer viva)
# ----------------------------------------------------------------------------
vida:
  origem: portfolio
  piscar: "ciclo de 5s; fecha entre 92% e 100% do ciclo"
  seguir_mouse: "os olhos (e a boca) acompanham o ponteiro em tempo real"
  acaso:
    descricao: "a cada 2.8–6s sorteia um gesto"
    sorteio:
      - { gesto: olhar_em_volta, chance: "40%", condicao: "mouse parado há > 2.5s", duracao: 1400ms }
      - { gesto: feliz,          chance: "22%", duracao: 1600ms }
      - { gesto: pulo,           chance: "18%", duracao: 800ms }
      - { gesto: piscadinha,     chance: "20%", duracao: 380ms }
    nao_interrompe: falando
  proposta_extra:
    origem: proposta
    regras:
      - "piscar duplo em 15% das vezes (mais natural)"
      - "ao mudar de estado, piscar 1x"
      - "pensando e ouvindo: piscar menos (foco)"

# ----------------------------------------------------------------------------
# 5. ESTADOS
# ----------------------------------------------------------------------------
estados:

  idle:
    origem: portfolio
    quando: "parada no canto esperando"
    olhos: "aberto, piscando a cada 5s, seguindo o mouse"
    boca: neutra
    corpo: "flutua + brilho pulsando + anel girando + líquido ondulando + anéis saindo"
    gestos: "acaso (olhar em volta, feliz, pulo, piscadinha)"
    dica: "balão 'Pergunte sobre o Ayalan' ao lado; some sozinho em 12s"

  hover:
    origem: portfolio
    quando: "mouse em cima do orbe"
    efeito: "para de flutuar e cresce 6% (scale 1.06)"

  chat_aberto:
    origem: portfolio
    quando: "painel de conversa aberto"
    olhos: "achatados em 4px (atenta, tranquila)"

  ouvindo:
    origem: proposta
    quando: "microfone ativo (versão TTS)"
    olhos: "abertos, piscando menos"
    boca: neutra
    corpo: "anéis de onda saem no ritmo do volume da voz do usuário"
    gesto: "olhar fixo no centro (não segue o mouse)"

  pensando:
    origem: portfolio
    quando: "calculando a resposta (laboratório) / esperando o modelo"
    olhos: "achatados 7/3, sem piscar"
    corpo: "líquido acelera (2.6s / 1.6s)"
    indicador: "balão com três pontinhos subindo em sequência (delay 150ms)"
    fala_de_preenchimento:
      origem: proposta
      se_demorar_mais_de: 2500ms
      frases: ["Hmm, deixa eu ver…", "Só um segundinho…", "Tô procurando no portfólio…"]

  falando:
    origem: portfolio
    quando: "respondendo"
    boca: "oval abrindo e fechando a cada 260ms"
    corpo: "líquido acelera; anéis de onda saem mais rápido (1.6s)"
    gestos: "acaso pausado"
    com_tts:
      origem: proposta
      boca: "segue os visemas do TTS (seção 7) em vez do loop fixo"
      aneis: "um anel por sílaba tônica"

  feliz:
    origem: portfolio
    quando: "gesto aleatório; ao voltar para o cartão do topo; resposta de sucesso"
    olhos: "meia-lua para cima"
    boca: sorriso
    duracao: 1600ms

  pulo:
    origem: portfolio
    quando: "gesto aleatório; ao pousar no canto depois do voo"
    animacao: "boing: achata (1.12 x 0.88), estica (0.93 x 1.08), assenta — 750ms"

  piscadinha:
    origem: portfolio
    quando: "gesto aleatório; piadas"
    olhos: "só o esquerdo fecha"
    duracao: 380ms

  voando:
    origem: portfolio
    quando: "página rola além de 80px (topo → canto) ou volta ao topo (canto → cartão)"
    animacao: "arco de 820ms: sobe ~70px no meio do caminho, gira ±16°, muda de tamanho"
    ao_pousar: "no canto dá um pulo; no cartão fica feliz"
    rastro: "o cartão vazio mostra 'a Zoe foi para o canto ↘'"

  fora_do_escopo:
    origem: portfolio
    quando: "pergunta que não é sobre o portfólio (idade, salário…)"
    olhos: aberto
    boca: neutra
    fala: "recusa educada + sugestões de perguntas"

  erro:
    origem: portfolio
    quando: "não conseguiu carregar a base de conhecimento"
    olhos: achatados
    gesto: "balança de lado 2x (proposta)"
    fala: "Não consegui carregar a base de conhecimento agora. Recarregue a página ou fale com o Ayalan pelo e-mail."

  empatica:
    origem: proposta
    quando: "usuário frustrado"
    olhos: "meia-lua para baixo"
    boca: "sorriso pequeno"
    corpo: "flutua mais devagar (6s), brilho mais suave"
    fala: { tom: calma, abertura: ["Poxa, entendo.", "Vamos achar isso juntos."] }

  confusa:
    origem: proposta
    quando: "não entendeu / baixa confiança"
    olhos: "um aberto, outro achatado"
    gesto: "inclina 10° e volta"
    fala: ["Não peguei direito, pode reformular?", "Você quis dizer o Harmony?"]

  dormindo:
    origem: proposta
    quando: "aba inativa > 5 min"
    olhos: fechados
    corpo: "brilho a 25%, sem anéis de onda, flutua devagar"
    indicador: "z z subindo"

transicoes:
  "idle -> pensando": "usuário enviou a pergunta"
  "pensando -> falando": "resposta pronta"
  "falando -> idle": "resposta terminou (+700ms)"
  "idle -> voando": "rolagem cruza 80px"
  "voando -> pulo": "pousou no canto"
  "voando -> feliz": "voltou ao cartão do topo"
  "idle -> chat_aberto": "clique no orbe"
  "* -> ouvindo": "microfone ativado (TTS)"
  "falando -> ouvindo": "usuário interrompeu: corta o áudio em ≤ 150ms (TTS)"
  "* -> empatica": "sentimento negativo detectado (proposta)"

# ----------------------------------------------------------------------------
# 6. SORRISOS E EXPRESSÕES (no orbe, a expressão é olhos + boca)
# ----------------------------------------------------------------------------
sorrisos:
  neutro:     { olhos: aberto,         boca: "arco 16%", origem: portfolio }
  feliz:      { olhos: "meia-lua ↑",   boca: "arco 26%", origem: portfolio }
  piscadinha: { olhos: "esq. fechado", boca: "arco 16%", origem: portfolio }
  travesso:   { olhos: piscadinha,     boca: "arco torto (canto direito mais alto)", origem: proposta }
  empatico:   { olhos: "meia-lua ↓",   boca: "arco 12%", origem: proposta }
  riso:       { olhos: "meia-lua ↑",   boca: "oval abre/fecha 3x + pulo", origem: proposta }
  regras:
    - "feliz no máximo 1x a cada 20s quando não for gesto aleatório"
    - "nunca feliz/riso em empatica, fora_do_escopo ou erro"

# ----------------------------------------------------------------------------
# 7. FALA (texto do portfólio + voz TTS deste repo)
# ----------------------------------------------------------------------------
fala:
  frases_do_portfolio:
    origem: portfolio
    saudacao: "Oi! Eu sou a Zoe, a assistente do portfólio do Ayalan. Pergunte sobre ele, o dia a dia de trabalho ou qualquer um dos projetos."
    sugestoes: ["Quem é você?", "O que você faz no dia a dia?", "Como funciona o Fluxo?",
                "Como funciona o gerador de solos?", "Como a Zoe funciona?", "Como entrar em contato?"]
    dica_flutuante: "Pergunte sobre o Ayalan"
    resposta: "texto + link para a seção do site de onde veio"
  voz:
    origem: proposta
    genero_percebido: feminina
    timbre: "médio, claro, sorridente"
    sotaque: neutro brasileiro
  tons:
    origem: proposta
    neutra:      { velocidade: 1.00, tom: "0st",  uso: "respostas informativas" }
    animada:     { velocidade: 1.06, tom: "+1st", uso: "saudação, feliz" }
    calma:       { velocidade: 0.92, tom: "-1st", uso: "empatica, passo a passo" }
    pensativa:   { velocidade: 0.95, tom: "0st",  uso: "frases de preenchimento" }
    brincalhona: { velocidade: 1.04, tom: "+2st", uso: "piadinha, piscadinha" }
    seria:       { velocidade: 0.97, tom: "-1st", uso: "erro, fora do escopo" }
  exemplo_ssml: |
    <speak>
      <prosody rate="106%" pitch="+1st">Oi! Eu sou a Zoe.</prosody>
      <break time="200ms"/>
      A assistente do portfólio do Ayalan. Quer saber de qual projeto?
    </speak>
  regras:
    - "responder primeiro, depois dizer onde está no site"
    - "frases curtas (≤ 20 palavras) por voz"
    - "não ler links em voz alta; mostrar como botão"
    - "suportar interrupção (barge-in) em ≤ 150ms"
  visemas:
    origem: proposta
    nota: "no orbe a boca é uma oval; o visema só muda largura x altura"
    repouso: { largura: "16%", altura: "0%" }    # silêncio, M, B, P
    A:  { largura: "15%", altura: "11%" }
    E:  { largura: "17%", altura: "7%" }
    I:  { largura: "18%", altura: "4%" }
    O:  { largura: "11%", altura: "10%" }
    U:  { largura: "8%",  altura: "6%" }
    fallback: "sem visemas → altura segue a amplitude do áudio, suavizada em 60ms"

# ----------------------------------------------------------------------------
# 8. ARTEFATOS DE CHATBOT AO REDOR DA ZOE
# ----------------------------------------------------------------------------
artefatos_ui:
  balao_dica:       { origem: portfolio, texto: "Pergunte sobre o Ayalan", some_em: 12s, mobile: escondido }
  painel_chat:      { origem: portfolio, tamanho: "400 x 580", entrada: "sobe 10px + escala 0.97 → 1, 220ms", cabecalho: "mini-orbe 30px + 'Assistente do portfólio'" }
  digitando:        { origem: portfolio, forma: "3 pontos 7px", animacao: "sobem 3px em sequência, 1s" }
  chips_sugestao:   { origem: portfolio, quantidade: "4 a 6" }
  links_de_fonte:   { origem: portfolio, forma: "pílulas com link para a seção usada na resposta" }
  botao_enviar:     { origem: portfolio, estilo: "gradiente roxo do orbe" }
  palco_pagina_zoe: { origem: portfolio, elementos: "2 anéis tracejados girando (40s e 60s) + 4 etiquetas: correção, classificador, TF-IDF, contexto" }
  cartao_topo:      { origem: portfolio, elementos: "orbe dentro de cartão azul pontilhado, cercado por 4 pastas de projeto" }
  ondas_de_voz:     { origem: proposta, forma: "anéis de onda reagindo ao volume (ouvindo/falando)" }
  zzz:              { origem: proposta, uso: dormindo }

# ----------------------------------------------------------------------------
# 9. APRESENTAÇÃO (abertura da Zoe)
# ----------------------------------------------------------------------------
apresentacao:
  origem: "proposta, usando só gestos que já existem no portfólio"
  duracao_total_ms: 6500
  roteiro:
    - { t: 0,    acao: "orbe aparece com o brilho subindo, olhos fechados" }
    - { t: 600,  acao: "abre os olhos e pisca 2x" }
    - { t: 1200, acao: "olha para a esquerda, para a direita, volta ao centro" }
    - { t: 2200, acao: "pulo (boing) + feliz" }
    - { t: 2600, acao: fala, texto: "Oi! Eu sou a Zoe.", tom: animada }
    - { t: 4000, acao: "pensando 600ms (olhos achatados, três pontinhos)" }
    - { t: 4600, acao: fala, texto: "Pergunte sobre o Ayalan ou os projetos dele.", tom: neutra }
    - { t: 6200, acao: "chips de sugestão aparecem; volta ao idle" }
  pular: "clique em qualquer lugar"

# ----------------------------------------------------------------------------
# 10. ACESSIBILIDADE
# ----------------------------------------------------------------------------
acessibilidade:
  origem: portfolio
  movimento_reduzido: "sem flutuar, girar, ondular, piscar, voo nem gestos; o olhar não segue o mouse"
  rotulos: "orbe é um <button> com aria-label 'Abrir o assistente do portfólio' e aria-expanded"
  foco: "anel lilás #C4B5FD de 3px"
  proposta:
    - "aria-live anunciando o estado ('Zoe está pensando')"
    - "toda fala TTS com legenda em texto"

# ----------------------------------------------------------------------------
# 11. ANIMAÇÕES EXTRAS (zoe-fx.js) — "quanto mais viva, melhor"
#     Todas usam as mesmas peças do orbe do portfólio (.orb, .orb-face i,
#     .orb-mouth, .orb-liquid) e funcionam no orbe pequeno (66px) e no grande.
#     origem: proposta
# ----------------------------------------------------------------------------
animacoes_extras:
  instalar: |
    <script src="zoe-fx.js"></script>
    <script>
      var orb = document.getElementById('orb');
      ZoeFx.vida(orb, { soltarArquivos: true });
      // exemplos: ZoeFx.absorver(orb); ZoeFx.confete(orb); ZoeFx.dancar(orb);
    </script>

  absorver:
    nome: "arquivos entrando + pensando"
    api: "ZoeFx.absorver(orb, { arquivos, palavras, intervalo, pensar })"
    roteiro:
      - "boca abre em 'o' mastigando e os olhos crescem (faminta)"
      - "cartões de arquivo (README.md, indice.json, modelo.py, motor.js…) aparecem em volta, um a cada 230ms"
      - "cada um faz uma curva, gira e encolhe até sumir dentro do orbe"
      - "a cada arquivo: 'gole' (achata e estica), um anel de onda e o líquido interno sobe um pouco"
      - "depois pensa: olhos achatados, líquido acelerado, palavras (Fluxo, Harmony, TF-IDF, contexto) orbitando em elipse, mais fracas quando passam por trás"
      - "termina com 'achei!': clarão, 12 estrelinhas saindo, pulo e olhos felizes; o líquido volta ao nível normal"
    cores_por_tipo: { md: azul, json: âmbar, py: verde, js: amarelo, html: laranja, csv: verde-água, pdf: vermelho, imagens: rosa }
    duracao: "~1.2s + 230ms por arquivo + 2.4s pensando + 1.6s comemorando"
    no_portfolio:
      - "ao abrir o chat pela primeira vez (ela 'lê' o portfólio)"
      - "no laboratório da página da Zoe, ao clicar em Analisar"
      - "ao perguntar 'Como a Zoe funciona?'"
      - "quando alguém arrasta arquivos para a página (usa os nomes reais)"

  carregando:  { api: "ZoeFx.carregando(orb, ms)", visual: "anel roxo se completa em volta dela enquanto pensa; termina em 'achei!'" }
  lendo:       { api: "ZoeFx.lendo(orb, ms)", visual: "folha aparece na frente; os olhos varrem linha por linha e cada linha 'acende'" }
  procurando:  { api: "ZoeFx.procurando(orb, ms)", visual: "lupa dá a volta no orbe e os olhos acompanham a lupa" }
  eureka:      { api: "ZoeFx.eureka(orb)", visual: "clarão, 12 estrelinhas, anel de onda, pulo e olhos felizes" }
  ola:         { api: "ZoeFx.ola(orb, texto)", visual: "balança de um lado para o outro (aceno) com balão 'oi!'" }
  surpresa:    { api: "ZoeFx.surpresa(orb)", visual: "olhos crescem, boca 'o', pulinho rápido e um '!' estourando" }
  corada:      { api: "ZoeFx.corada(orb, ms)", visual: "bochechas rosas aparecem, olhos felizes e inclina a cabeça, tímida" }
  coracoes:    { api: "ZoeFx.coracoes(orb)", visual: "corações rosas sobem balançando; ela fica corada" }
  confete:     { api: "ZoeFx.confete(orb)", visual: "40 confetes nas cores do portfólio explodem para cima e caem com gravidade; gelatina" }
  dancar:      { api: "ZoeFx.dancar(orb, ms)", visual: "balança no ritmo com olhos felizes e notas musicais saindo (combina com o Harmony)" }
  tonta:       { api: "ZoeFx.tonta(orb, ms)", visual: "olhos viram espirais girando, boca torta e 3 estrelas orbitando a cabeça" }
  bocejo:      { api: "ZoeFx.bocejo(orb)", visual: "olhos quase fechados, boca abre devagar e o corpo estica" }
  gelatina:    { api: "ZoeFx.gelatina(orb)", visual: "tremida elástica de gelatina" }
  glitch:      { api: "ZoeFx.glitch(orb)", visual: "cores trocam e ela treme em degraus (para erros)" }

  comportamentos_automaticos:      # ZoeFx.vida(orb)
    clique: gelatina
    cinco_cliques_em_2s: tonta
    rolar_pagina: "inclina até 12° na direção da rolagem e volta"
    arrastar_arquivo_na_pagina: "fica faminta (boca aberta) esperando"
    soltar_arquivo: "absorver com os nomes reais dos arquivos"
    parado_25s: bocejo
    voltar_para_a_aba: "surpresa + balão 'voltou!'"
    copiar_texto_da_pagina: corada
    gestos_ao_acaso_extras: [ola, procurando, corada, dancar, lendo]

  sugestao_de_gatilhos_no_chat:
    "pensando (motor calculando)": "lendo ou procurando"
    "resposta encontrada": eureka
    "pergunta sobre o Harmony": dancar
    "elogio / obrigado": coracoes
    "pergunta fora do escopo": "surpresa leve, depois neutra"
    "erro ao carregar a base": glitch

  movimento_reduzido: "sem partículas nem voo; só a expressão (olhos e boca) muda"
